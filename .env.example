# Copiar como .env y completar con valores reales. .env NO se versiona.

# --- AWS Cognito (compartido por ambos microservicios: deben resolver el mismo issuer) ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# --- Base de datos: users ---
USERS_DB_USER=users
USERS_DB_PASSWORD=changeme
USERS_DB_NAME=users

# --- Base de datos: sigpel ---
SIGPEL_DB_USER=sigpel
SIGPEL_DB_PASSWORD=changeme
SIGPEL_DB_NAME=sigpel

# --- S3 (imagenes de equipos) ---
# Las credenciales NO van aqui: sigpel-microservice usa el IAM Role de la
# instancia EC2 (sigpel-ec2-s3-role) via DefaultCredentialsProvider.
S3_BUCKET_NAME=sigpel-equipos-imagenes-jpmora

# --- nginx (puerto expuesto en el host) ---
HOST_PORT=9090

# --- pgAdmin ---
# ".local" es un dominio reservado y pgAdmin lo rechaza al arrancar
# ("is not a valid email address") -- usa un dominio real aqui.
PGADMIN_EMAIL=admin@sigpel-demo.com
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050
