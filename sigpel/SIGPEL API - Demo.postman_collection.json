              "raw": "{{base_url}}/equipment?categoryId={{category_id}}&status=MAINTENANCE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{category_id}}",
                  "description": "Optional, combinable with status"
