            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": {{category_id}},\n  \"name\": \"\",\n  \"serialNumber\": \"\",\n  \"description\": \"Classroom projector, includes HDMI cable\"\n}"
            },
