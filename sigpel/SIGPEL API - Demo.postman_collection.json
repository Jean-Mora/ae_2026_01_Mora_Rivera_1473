      "name": "Categories",
      "item": [
        {
          "name": "List categories (public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create category (ENCARGADO)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_encargado}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Devuelve 409 Conflict si ya existe una categoria con el mismo nombre (sin distinguir mayusculas/minusculas)."
          },
          "response": []
        },
        {
          "name": "Update category (ENCARGADO)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_encargado}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptops\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories",
                "{{category_id}}"
              ]
            },
            "description": "Devuelve 409 Conflict si el nuevo nombre ya lo tiene otra categoria."
          },
          "response": []
        },
        {
          "name": "Delete category (ENCARGADO)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
